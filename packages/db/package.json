{
	"name": "@repo/db",
	"version": "0.0.0",
	"main": "./generated/prisma/index.js",
	"types": "./generated/prisma/index.d.ts",
	"exports": {
		".": "./generated/prisma/index.js"
	},
	"scripts": {
		"db:generate": "dotenv -e ../../apps/server/.env -- prisma generate",
		"db:migrate": "dotenv -e ../../apps/server/.env -- prisma migrate dev",
		"db:deploy": "dotenv -e ../../apps/server/.env -- prisma migrate deploy",
		"db:studio": "dotenv -e ../../apps/server/.env -- prisma studio",
		"db:reset": "dotenv -e ../../apps/server/.env -- prisma migrate reset --force",
		"db:seed:core": "dotenv -e ../../apps/server/.env -- bun run prisma/seed-db/seed-core.ts",
		"db:seed:billing": "dotenv -e ../../apps/server/.env -- bun run demo-data/seed-billing-run.ts",
		"db:seed:demo": "dotenv -e ../../apps/server/.env -- bun run demo-data/seed-demo-data.ts",
		"db:seed:tui": "dotenv -e ../../apps/server/.env -- bun run seed-tui/main.ts",
		"db:seed": "bun run db:seed:core",
		"db:seed:all": "bun run db:seed && bun run db:seed:demo"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@prisma/client-runtime-utils": "^7.3.0",
		"dotenv": "^16.6.1",
		"pg": "^8.16.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.2.0",
		"@types/pg": "^8.15.5",
		"dotenv-cli": "^7.4.4",
		"prisma": "^7.3.0"
	}
}
