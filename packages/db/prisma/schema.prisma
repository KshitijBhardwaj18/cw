generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BETTER AUTH TABLES — do not modify
// ============================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  systemRole     SystemRole       @default(MEMBER)
  projectMembers ProjectMember[]
  githubConnections   GithubConnection[]
  auditLogs             AuditLog[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Organization {
  id        String    @id
  name      String
  slug      String?   @unique
  logo      String?
  createdAt DateTime
  metadata  String?
  members   Member[]
  projects  Project[]
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PLATFORM TABLES
// ============================================

model Project {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  slug                 String
  githubOwner          String?
  githubRepo           String?
  githubBranch         String?  @default("main")
  githubInstallationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments         Environment[]
  members              ProjectMember[]

  @@unique([organizationId, slug])
}

model Environment {
  id                   String          @id @default(cuid())
  projectId            String
  type                 EnvironmentType
  awsAccountId         String?
  awsRoleArn           String?
  region               String?
  domain               String?
  pulumiStackName      String?
  pulumiBackendBucket  String?
  imageUri             String?
  setupComplete        Boolean         @default(false)
  heizenConfig         Json?
  stackOutputs         Json?
  status               EnvironmentStatus @default(NOT_DEPLOYED)
  lastDeployedAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  envVars              EnvVariable[]
  deployments          Deployment[]
  resources            StackResource[]

  @@unique([projectId, type])
}

model EnvVariable {
  id              String   @id @default(cuid())
  environmentId   String
  service         String
  key             String
  value           String
  isAutoGenerated Boolean  @default(false)
  dismissed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, service, key])
}

model Deployment {
  id             String           @id @default(cuid())
  environmentId  String
  triggeredBy    String
  commitSha      String?
  commitMessage  String?
  imageUri       String?
  status         DeploymentStatus @default(QUEUED)
  errorMessage   String?
  stackOutputs   Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  environment    Environment      @relation(fields: [environmentId], references: [id])
  logs           DeploymentLog[]
}

model DeploymentLog {
  id           String          @id @default(cuid())
  deploymentId String
  timestamp    DateTime        @default(now())
  phase        DeploymentPhase
  level        String
  message      String
  deployment   Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
}

model StackResource {
  id            String   @id @default(cuid())
  environmentId String
  pulumiUrn     String
  type          String
  name          String
  properties    Json
  dependencies  String[]
  updatedAt     DateTime @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, pulumiUrn])
  @@index([environmentId, type])
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model GithubConnection {
  id              String            @id @default(cuid())
  installationId  String            @unique
  accountLogin    String
  accountType     GithubAccountType
  addedByUserId   String?
  createdAt       DateTime          @default(now())
  addedBy         User?             @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([accountLogin])
}

model AuditLog {
  id            String        @id @default(cuid())
  actorId       String?
  action        AuditAction
  resourceType  AuditResource
  resourceId    String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  actor         User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
}

// ============================================
// ENUMS
// ============================================

enum EnvironmentType {
  STAGING
  PRODUCTION
}

enum EnvironmentStatus {
  NOT_DEPLOYED
  DEPLOYING
  LIVE
  FAILED
  DESTROYING
  DESTROYED
}

enum DeploymentStatus {
  QUEUED
  DEPLOYING
  SUCCESS
  FAILED
  CANCELLED
}

enum DeploymentPhase {
  PULUMI
  SYSTEM
}

enum SystemRole {
  MEMBER
  ADMIN
}

enum ProjectRole {
  OWNER
  DEPLOYER
  VIEWER
}

enum GithubAccountType {
  USER
  ORGANIZATION
}

enum AuditAction {
  DEPLOY_TRIGGERED
  ENV_VARS_REPLACED
  GITHUB_CONNECTION_ADDED
  GITHUB_CONNECTION_REMOVED
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DELETED
  PROJECT_DELETED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_ROLE_CHANGED
  PROJECT_MEMBER_REMOVED
}

enum AuditResource {
  PROJECT
  ENVIRONMENT
  USER
  GITHUB_CONNECTION
  PROJECT_MEMBER
}
