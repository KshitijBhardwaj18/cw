generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(CANDIDATE_USER)
  subRole       String?

  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  title       String?
  phoneNumber String?
  officePhone String?
  timeZone    String?
  mspId       String? @db.Uuid
  msp         MSP?    @relation(fields: [mspId], references: [id], onDelete: Cascade)

  sessions Session[]
  accounts Account[]

  members                        Member[]
  departmentUsers                DepartmentUser[]
  departmentTimekeepingApprovers DepartmentTimekeepingApprover[]

  vendorUser VendorUser?

  documents Document[]
  notes     Note[]

  tagsCreated Tag[] @relation("TagCreatedBy")

  questionsCreated Question[] @relation("QuestionCreatedBy")
  questionsUpdated Question[] @relation("QuestionUpdatedBy")

  createdOrganizationOccupations OrganizationOccupation[] @relation("OrganizationOccupationCreatedBy")
  updatedOrganizationOccupations OrganizationOccupation[] @relation("OrganizationOccupationUpdatedBy")
  createdOrganizationSpecialties OrganizationSpecialty[]  @relation("OrganizationSpecialtyCreatedBy")
  updatedOrganizationSpecialties OrganizationSpecialty[]  @relation("OrganizationSpecialtyUpdatedBy")
  organizationSpecialties        OrganizationSpecialty[]

  createdQuestionnaires Questionnaire[] @relation("QuestionnaireCreatedBy")
  updatedQuestionnaires Questionnaire[] @relation("QuestionnaireUpdatedBy")

  createdTaggingRules         TaggingRule[]         @relation("TaggingRuleCreatedBy")
  updatedTaggingRules         TaggingRule[]         @relation("TaggingRuleUpdatedBy")
  createdTaggingRuleQuestions TaggingRuleQuestion[] @relation("TaggingRuleQuestionCreatedBy")
  updatedTaggingRuleQuestions TaggingRuleQuestion[] @relation("TaggingRuleQuestionUpdatedBy")

  createdComplianceWalletTemplates ComplianceWalletTemplate[] @relation("ComplianceWalletTemplateCreatedBy")
  updatedComplianceWalletTemplates ComplianceWalletTemplate[] @relation("ComplianceWalletTemplateUpdatedBy")

  createdMatchingLogics MatchingLogic[] @relation("MatchingLogicCreatedBy")
  updatedMatchingLogics MatchingLogic[] @relation("MatchingLogicUpdatedBy")

  candidates        Candidate[]
  createdCandidates Candidate[] @relation("CandidateCreatedBy")
  updatedCandidates Candidate[] @relation("CandidateUpdatedBy")
  invitedCandidates Candidate[] @relation("CandidateInvitedBy")

  hiringRequisitionTemplates  RequisitionTemplate[] @relation("RequisitionTemplateHiringManager")
  createdRequisitionTemplates RequisitionTemplate[] @relation("RequisitionTemplateCreatedBy")
  updatedRequisitionTemplates RequisitionTemplate[] @relation("RequisitionTemplateUpdatedBy")

  hiringRequisitions   Requisition[] @relation("RequisitionHiringManager")
  approvedRequisitions Requisition[] @relation("RequisitionApprovedBy")
  createdRequisitions  Requisition[] @relation("RequisitionCreatedBy")
  updatedRequisitions  Requisition[] @relation("RequisitionUpdatedBy")

  createdSubmissions     Submission[]            @relation("SubmissionCreatedBy")
  updatedSubmissions     Submission[]            @relation("SubmissionUpdatedBy")
  submissionInterviewers SubmissionInterviewer[]

  createdPlacements         Placement[] @relation("PlacementCreatedBy")
  updatedPlacements         Placement[] @relation("PlacementUpdatedBy")
  placementsAsVendorContact Placement[] @relation("PlacementVendorContact")
  placementsHiringManaged   Placement[] @relation("PlacementHiringManager")
  placementsAccepted        Placement[] @relation("PlacementAcceptedBy")
  placementsTerminated      Placement[] @relation("PlacementTerminatedBy")

  placementOfferHistories PlacementOfferHistory[]
  placementTasksAssigned  PlacementTask[]         @relation("PlacementTaskAssignedTo")
  placementTasksCreated   PlacementTask[]         @relation("PlacementTaskCreatedBy")
  placementNotes          PlacementNote[]

  verifiedCandidateCompliances CandidateCompliance[] @relation("CandidateComplianceVerifiedBy")
  uploadedCandidateCompliances CandidateCompliance[] @relation("CandidateComplianceUploadedBy")

  createdOrganizationMetrics OrganizationMetric[] @relation("OrganizationMetricCreatedBy")

  createdProjects Project[] @relation("ProjectCreatedBy")
  updatedProjects Project[] @relation("ProjectUpdatedBy")

  createdWorkforceLists     WorkforceList[]       @relation("WorkforceListCreatedBy")
  updatedWorkforceLists     WorkforceList[]       @relation("WorkforceListUpdatedBy")
  workforceListMembersAdded WorkforceListMember[]

  createdShiftTemplates ShiftTemplate[] @relation("ShiftTemplateCreatedBy")
  updatedShiftTemplates ShiftTemplate[] @relation("ShiftTemplateUpdatedBy")

  createdPerDiemShifts          PerDiemShift[]      @relation("PerDiemShiftCreatedBy")
  updatedPerDiemShifts          PerDiemShift[]      @relation("PerDiemShiftUpdatedBy")
  perDiemAssignmentsAssignedBy  PerDiemAssignment[] @relation("PerDiemAssignmentAssignedBy")
  perDiemAssignmentsApprovedBy  PerDiemAssignment[] @relation("PerDiemAssignmentApprovedBy")
  perDiemAssignmentsCancelledBy PerDiemAssignment[] @relation("PerDiemAssignmentCancelledBy")

  timesheetDisputesRaised   TimesheetDispute[] @relation("TimesheetDisputeRaisedBy")
  timesheetDisputesAssigned TimesheetDispute[] @relation("TimesheetDisputeAssignedTo")
  timesheetDisputesResolved TimesheetDispute[] @relation("TimesheetDisputeResolvedBy")
  timesheetEntriesApproved  TimesheetEntry[]   @relation("TimesheetEntryApprovedBy")

  createdComplianceChecklists ComplianceChecklist[] @relation("ComplianceChecklistCreatedBy")
  updatedComplianceChecklists ComplianceChecklist[] @relation("ComplianceChecklistUpdatedBy")

  createdShiftRoutingSettings ShiftRoutingSettings[] @relation("ShiftRoutingSettingsCreatedBy")
  updatedShiftRoutingSettings ShiftRoutingSettings[] @relation("ShiftRoutingSettingsUpdatedBy")

  createdGrievances      Grievance[]     @relation("GrievanceCreatedBy")
  grievanceTasksAssigned GrievanceTask[] @relation("GrievanceTaskAssignedTo")
  createdGrievanceTasks  GrievanceTask[] @relation("GrievanceTaskCreatedBy")

  invoicesSubmitted Invoice[] @relation("InvoiceSubmittedBy")
  invoicesReviewed  Invoice[] @relation("InvoiceReviewedBy")
  invoicesApproved  Invoice[] @relation("InvoiceApprovedBy")
  invoicesRoutedTo  Invoice[] @relation("InvoiceRoutedTo")
  invoicesRoutedBy  Invoice[] @relation("InvoiceRoutedBy")

  notifications NotificationOrg[]
  activityLogs  ActivityLogOrg[]

  @@index([mspId])
  @@map("user")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  activeOrganizationId String?  @db.Uuid
  vendorId             String?  @db.Uuid
  vendorUserId         String?  @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String
  email                String
  phone                String
  industry             OrganizationIndustry
  organizationType     OrganizationType
  timeZone             OrganizationTimezone @map("timezone")
  website              String?
  logo                 String?
  metadata             String?
  serviceAgreement     String?
  description          String?
  agreementRenewalDate DateTime?
  isActive             Boolean              @default(true) @map("is_active")
  expectedAnnualSpend  Float?               @map("expected_annual_spend")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  documents                     Document[]
  members                       Member[]
  notes                         Note[]
  locations                     OrganizationLocation[]
  departments                   Department[]
  msplinkedOrgs                 MSPLinkedOrg[]
  organizationVendors           OrganizationVendor[]
  organizationOccupations       OrganizationOccupation[]
  questionnaires                Questionnaire[]
  organizationSpecialties       OrganizationSpecialty[]
  matchingLogics                MatchingLogic[]
  complianceWalletTemplates     ComplianceWalletTemplate[]
  complianceWalletTemplateItems ComplianceWalletTemplateItem[]
  taggingRules                  TaggingRule[]
  candidates                    Candidate[]
  placements                    Placement[]
  requisitionTemplates          RequisitionTemplate[]
  requisitions                  Requisition[]
  submissions                   Submission[]
  projects                      Project[]
  organizationMetrics           OrganizationMetric[]
  organizationMetricSnapshots   OrganizationMetricSnapshot[]
  workforceLists                WorkforceList[]
  shiftTemplates                ShiftTemplate[]
  perDiemShifts                 PerDiemShift[]
  shiftRoutingSettings          ShiftRoutingSettings?
  shiftRoutingTiers             ShiftRoutingTier[]
  grievances                    Grievance[]
  invoices                      Invoice[]
  complianceChecklists          ComplianceChecklist[]
  timesheets                    Timesheet[]
  timesheetEntries              TimesheetEntry[]
  organizationPayCodes          OrganizationPayCode[]
  organizationHolidays          OrganizationHoliday[]
  missingTimeCases              MissingTimeCase[]
  timekeepingPolicy             TimekeepingPolicy?
  billingConfigs                BillingConfig[]
  workforceBillingRates         OrganizationWorkforceBillingRate[]
  notifications                 NotificationOrg[]
  activityLogs                  ActivityLogOrg[]
  candidateSummaries            CandidateSummary[]
  placementSummaries            PlacementSummary[]
  timekeepingSummaries          TimekeepingSummary[]
  requisitionAttentionRules     RequisitionAttentionRule[]
  agingRules                    AgingRule[]

  @@unique([slug])
  @@map("organization")
}

model AgingRule {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid
  stageTransition AgingRuleStageTransition
  thresholdValue  Int
  thresholdUnit   AgingRuleUnit
  isEnabled       Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stageTransition])
  @@map("aging_rule")
}

enum AgingRuleStageTransition {
  SUBMISSION_TO_QUALIFIED
  QUALIFIED_TO_SHORTLISTED
  SHORTLISTED_TO_INTERVIEW_SCHEDULED
  INTERVIEW_SCHEDULED_TO_INTERVIEW_COMPLETED
  INTERVIEW_COMPLETED_TO_OFFER_SENT
  OFFER_SENT_TO_OFFER_ACCEPTED
  OFFER_ACCEPTED_TO_ONBOARDING
  ONBOARDING_TO_STARTED
  SUBMITTED_TO_REJECTED
  OFFER_SENT_TO_OFFER_DECLINED
}

enum AgingRuleUnit {
  HOURS
  DAYS
}

model RequisitionAttentionRule {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  key            RequisitionAttentionRuleKey
  thresholdValue Int
  thresholdUnit  RequisitionAttentionRuleUnit
  isEnabled      Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("requisition_attention_rule")
}

enum RequisitionAttentionRuleKey {
  SLOW_TIME_TO_FILL
  LOW_SUBMISSION_COUNT
  NO_SUBMISSIONS
}

enum RequisitionAttentionRuleUnit {
  HOURS
  DAYS
  COUNT
}

model OrganizationLocation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  address        String
  city           String
  state          String
  zipCode        String
  locationType   LocationType
  phone          String?
  email          String?
  costCenter     String?
  photoUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments                 Department[]
  requisitionTemplates        RequisitionTemplate[]
  requisitions                Requisition[]
  placements                  Placement[]
  candidatePreferredLocations CandidatePreferredLocation[]
  shiftTemplates              ShiftTemplate[]
  perDiemShifts               PerDiemShift[]
  timesheets                  Timesheet[]
  timesheetEntries            TimesheetEntry[]
  missingTimeCases            MissingTimeCase[]
  timekeepingSummaries        TimekeepingSummary[]

  @@index([organizationId])
  @@map("organization_location")
}

model Department {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  locationId     String         @db.Uuid
  name           String
  departmentType DepartmentType
  costCenter     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                       OrganizationLocation            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  departmentOccupations          DepartmentOccupation[]
  departmentSpecialties          DepartmentSpecialty[]
  departmentUsers                DepartmentUser[]
  departmentTimekeepingApprovers DepartmentTimekeepingApprover[]
  requisitionTemplates           RequisitionTemplate[]
  requisitions                   Requisition[]
  placements                     Placement[]
  shiftTemplates                 ShiftTemplate[]
  perDiemShifts                  PerDiemShift[]
  timesheets                     Timesheet[]
  timesheetEntries               TimesheetEntry[]
  missingTimeCases               MissingTimeCase[]
  timekeepingSummaries           TimekeepingSummary[]

  @@index([organizationId])
  @@index([locationId])
  @@map("department")
}

model DepartmentOccupation {
  id                       String   @id @default(uuid()) @db.Uuid
  departmentId             String   @db.Uuid
  organizationOccupationId String   @db.Uuid
  createdAt                DateTime @default(now())

  department             Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organizationOccupation OrganizationOccupation @relation(fields: [organizationOccupationId], references: [id], onDelete: Cascade)

  @@unique([departmentId, organizationOccupationId])
  @@index([departmentId])
  @@index([organizationOccupationId])
  @@map("department_occupation")
}

model DepartmentSpecialty {
  id                      String   @id @default(uuid()) @db.Uuid
  departmentId            String   @db.Uuid
  organizationSpecialtyId String   @db.Uuid
  createdAt               DateTime @default(now())

  department            Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organizationSpecialty OrganizationSpecialty @relation(fields: [organizationSpecialtyId], references: [id], onDelete: Cascade)

  @@unique([departmentId, organizationSpecialtyId])
  @@index([departmentId])
  @@index([organizationSpecialtyId])
  @@map("department_specialty")
}

model DepartmentTimekeepingApprover {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
  @@map("department_timekeeping_approver")
}

model DepartmentUser {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
  @@map("department_user")
}

model Member {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  userId         String                   @db.Uuid
  role           MemberRole
  status         OrganizationMemberStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  lastInviteStatus       MemberInviteStatus @default(NOT_SENT) @map("last_invite_status")
  lastInviteAt           DateTime?          @map("last_invite_at")
  lastInviteScheduledFor DateTime?          @map("last_invite_scheduled_for")
  lastInviteJobId        String?            @map("last_invite_job_id") @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@map("member")
}

model Vendor {
  id                               String                            @id @default(uuid()) @db.Uuid
  logo                             String?
  name                             String
  industries                       OrganizationIndustry[]
  certifiedBusinessClassifications CertifiedBusinessClassification[]
  about                            String?
  isActive                         Boolean                           @default(true)
  taxId                            String?
  phoneNumber                      String?
  website                          String?
  addressId                        String?                           @db.Uuid
  annualRevenue                    Float?
  employeeCount                    Int?
  internalId                       String                            @unique
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt

  address                         Address?                         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  vendorUsers                     VendorUser[]
  documents                       Document[]
  notes                           Note[]
  vendorOccupationSpecializations VendorOccupationSpecialization[]
  organizationVendors             OrganizationVendor[]
  candidates                      Candidate[]
  requisitionTemplateVendors      RequisitionTemplateVendor[]
  requisitionVendors              RequisitionVendor[]
  submissions                     Submission[]
  perDiemAssignments              PerDiemAssignment[]
  invoices                        Invoice[]
  billingConfigs                  BillingConfig[]
  candidateSummaries              CandidateSummary[]
  placementSummaries              PlacementSummary[]
  timekeepingSummaries            TimekeepingSummary[]
  placements                      Placement[]

  @@index([internalId])
  @@index([addressId])
  @@map("vendor")
}

model VendorOccupationSpecialization {
  id           String   @id @default(uuid()) @db.Uuid
  vendorId     String   @db.Uuid
  occupationId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  occupation Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@unique([vendorId, occupationId], name: "vendor_occupation_unique")
  @@index([vendorId])
  @@index([occupationId])
  @@map("vendor_occupation_specialization")
}

model OrganizationVendor {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @db.Uuid
  vendorId            String                   @db.Uuid
  status              OrganizationVendorStatus @default(PENDING)
  startDate           DateTime?
  contractDocumentKey String?
  contractFileName    String?
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, vendorId], name: "org_vendor_unique")
  @@index([organizationId])
  @@index([vendorId])
  @@map("organization_vendor")
}

model VendorUser {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @db.Uuid
  vendorId  String         @db.Uuid
  role      VendorUserRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  savedRequisitions VendorUserSavedRequisition[]

  @@index([userId])
  @@index([vendorId])
  @@map("vendor_user")
}

model VendorUserSavedRequisition {
  id            String   @id @default(uuid()) @db.Uuid
  vendorUserId  String   @db.Uuid
  requisitionId String   @db.Uuid
  createdAt     DateTime @default(now())

  vendorUser  VendorUser  @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@unique([vendorUserId, requisitionId])
  @@index([vendorUserId])
  @@index([requisitionId])
  @@map("vendor_user_saved_requisitions")
}

model MSP {
  id                       String               @id @default(uuid()) @db.Uuid
  name                     String
  logo                     String?
  industry                 OrganizationIndustry
  organizationType         MSPOrganizationType
  headquartersId           String               @db.Uuid
  billingId                String?              @db.Uuid
  isBillingSame            Boolean              @default(true)
  phoneNumber              String
  timeZone                 OrganizationTimezone @map("timezone")
  msaDocument              String
  msaFileName              String?
  msaUploadedAt            DateTime?
  msaAgreementRevisionDate DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  headquarters  Address        @relation("HeadquartersAddress", fields: [headquartersId], references: [id])
  billing       Address?       @relation("BillingAddress", fields: [billingId], references: [id])
  documents     Document[]
  notes         Note[]
  msplinkedOrgs MSPLinkedOrg[]
  users         User[]

  @@index([headquartersId])
  @@index([billingId])
  @@map("msp")
}

model MSPLinkedOrg {
  id                          String    @id @default(uuid()) @db.Uuid
  mspId                       String    @db.Uuid
  organizationId              String    @db.Uuid
  addendumAgreement           String
  addendumAgreementFileName   String?
  addendumAgreementUploadedAt DateTime?
  addendumRevisionDate        DateTime?
  startDate                   DateTime
  renewalDate                 DateTime
  possibleCancellationDate    DateTime?
  mspFeePercentage            Float
  saasFeePercentage           Float
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  msp          MSP          @relation(fields: [mspId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([mspId, organizationId], name: "msp_org_unique")
  @@index([mspId])
  @@index([organizationId])
  @@map("msp_linked_orgs")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  headquartersOf MSP[]    @relation("HeadquartersAddress")
  billingOf      MSP[]    @relation("BillingAddress")
  vendors        Vendor[]

  @@map("address")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  type           DocumentType
  description    String?
  url            String
  uploadedAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  uploadedBy     String?      @db.Uuid
  mspId          String?      @db.Uuid
  vendorId       String?      @db.Uuid
  organizationId String?      @db.Uuid

  user         User?         @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  msp          MSP?          @relation(fields: [mspId], references: [id], onDelete: Cascade)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
  @@index([mspId])
  @@index([vendorId])
  @@index([organizationId])
  @@map("document")
}

model Note {
  id             String   @id @default(uuid()) @db.Uuid
  type           NoteType
  notes          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?  @db.Uuid
  mspId          String?  @db.Uuid
  vendorId       String?  @db.Uuid
  organizationId String?  @db.Uuid

  user         User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  msp          MSP?          @relation(fields: [mspId], references: [id], onDelete: Cascade)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([mspId])
  @@index([vendorId])
  @@index([organizationId])
  @@map("note")
}

model Occupation {
  id           String                @id @default(uuid()) @db.Uuid
  name         String
  code         String
  industry     OrganizationIndustry?
  acronym      String
  description  String?
  status       OccupationStatus      @default(ACTIVE)
  hasSpecialty Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  occupationSpecialties           OccupationSpecialty[]
  vendorOccupationSpecializations VendorOccupationSpecialization[]
  organizationOccupations         OrganizationOccupation[]
  candidates                      Candidate[]
  shiftTemplates                  ShiftTemplate[]
  perDiemShifts                   PerDiemShift[]
  candidateSummaries              CandidateSummary[]

  @@index([status])
  @@map("occupation")
}

model Specialty {
  id          String          @id @default(uuid()) @db.Uuid
  acronym     String
  name        String
  group       String?
  description String?
  status      SpecialtyStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  occupationSpecialties   OccupationSpecialty[]
  organizationSpecialties OrganizationSpecialty[]
  candidateSpecialties    CandidateSpecialty[]
  perDiemShiftSpecialties PerDiemShiftSpecialty[]
