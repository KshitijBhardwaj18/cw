{
	"mcpServers": {
		"better-auth": {
			"type": "streamableHttp",
			"url": "https://mcp.inkeep.com/better-auth/mcp"
		},
		"next-devtools": {
			"command": "npx",
			"args": ["-y", "next-devtools-mcp@latest"]
		},
		"tanstack": {
			"command": "npx",
			"args": ["@tanstack/cli", "mcp"]
		},
		"shadcn": {
			"command": "npx",
			"args": ["shadcn@latest", "mcp"]
		}
	}
}
