// INDEXES REMOVED FOR DBML COMPATIBILITY IN DBDIAGRAM.IO
// If you want to model indexes visually, re-add them using dbdiagram's supported
// `indexes` blocks inside each `Table` or `Index {}` syntax from the docs.

// =============================================================================
// ORG PORTAL EXTENSIONS FROM schema.sql (shift templates, per-diem, finance, grievances, analytics)
// =============================================================================

// Reusable shift config — populated from "Create Shift Template" modal
Table shift_templates {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]

  // ── Core Identity ──────────────────────────────────────────────────────────
  template_name varchar(255) [not null, note: 'e.g. ICU Day Shift - RN']
  occupation_id uuid [not null, note: 'Role field in UI']
  department_id uuid [not null]
  location_id uuid [not null]
  shift_type varchar(50) [not null, note: 'day | night | evening | on_call | weekend']
  duration_hours decimal(5,2) [not null, note: 'Duration (hours) field']

  // ── Rates ─────────────────────────────────────────────────────────────────
  base_rate decimal(10,2) [not null, note: 'Base Rate ($/hour) — candidate-facing rate']
  base_bill_rate decimal(10,2) [note: 'Base Bill Rate ($/hour) — rate charged to client']
  vendor_rate_markup_percent decimal(5,2) [note: 'Vendor Rate Markup (%) — added to base rate for vendor rate']

  // ── Visibility ─────────────────────────────────────────────────────────────
  limit_shift_visibility boolean [default: false, note: 'hide unit/dept details until X hours before start']
  visibility_unlock_hours integer [note: 'hours before shift start to reveal details; null when limit_shift_visibility = false']

  // ── Incentives ────────────────────────────────────────────────────────────
  offer_incentive boolean [default: false]
  incentive_by_hour decimal(10,2) [note: 'Incentive by Hour ($/hour) — added to base rate per hour worked']
  incentive_by_shift decimal(10,2) [note: 'Incentive by Shift ($/shift) — flat bonus for the entire shift']

  // ── Metadata ──────────────────────────────────────────────────────────────
  is_active boolean [default: true]
  usage_count int [default: 0]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Individual per diem shift posting — created via "Create Per Diem Shift" flow
Table per_diem_shifts {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  shift_number varchar(50) [note: 'auto-generated display ID']

  // ── Template (auto-populates shift details) ────────────────────────────────
  shift_template_id uuid [note: 'optional; pre-fills fields when selected']

  // ── Shift Details ─────────────────────────────────────────────────────────
  shift_date date [not null]
  start_time time [not null]
  end_time time [not null]
  total_shift_hours decimal(5,2) [not null, note: 'Total Shift Hours field; derived from start/end but stored']
  shift_type varchar(50) [not null, note: 'day | night | evening | on_call | weekend']
  occupation_id uuid [not null]
  specialty_id uuid
  department_id uuid
  location_id uuid [not null]

  // ── Rates & Cost ──────────────────────────────────────────────────────────
  shift_rate decimal(10,2) [not null, note: 'Shift Rate ($/hour) — candidate rate; must be >= floor rate']
  vendor_rate decimal(10,2) [not null, note: 'Vendor Rate ($/hour) — rate paid to the vendor']
  total_cost decimal(10,2) [note: 'computed: shift_rate × total_shift_hours']

  // ── Notifications ─────────────────────────────────────────────────────────
  send_personalized_notification boolean [default: false, note: 'Notify specific workforce groups or candidates']

  // ── Status & Visibility ───────────────────────────────────────────────────
  status varchar(30) [default: 'open', note: 'open | in_progress | completed | cancelled']
  is_public boolean [default: true, note: 'Public badge in list view; false = private/restricted visibility']
  is_urgent boolean [default: false]
  published_at timestamp

  // ── Routing ───────────────────────────────────────────────────────────────
  routing_rule_id uuid

  // ── Metadata ──────────────────────────────────────────────────────────────
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table per_diem_assignments {
  id uuid [pk, default: `uuid_generate_v4()`]
  shift_id uuid [not null]
  candidate_id uuid [not null]
  status varchar(50) [default: 'assigned']
  assigned_at timestamp [default: `now()`]
  assigned_by uuid
  confirmed_at timestamp
  clock_in_time timestamp
  clock_out_time timestamp
  break_start_time timestamp
  break_end_time timestamp
  actual_hours decimal(5,2)
  approved_by uuid
  approved_at timestamp
  rejection_reason text
  candidate_rating decimal(3,2)
  shift_rating decimal(3,2)
  candidate_feedback text
  client_feedback text
  cancelled_at timestamp
  cancelled_by uuid
  cancellation_reason text
  cancellation_fee decimal(10,2)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table timesheet_disputes {
  id uuid [pk, default: `uuid_generate_v4()`]
  timesheet_id uuid [not null]
  dispute_type varchar(100)
  description text [not null]
  original_hours decimal(5,2)
  disputed_hours decimal(5,2)
  original_amount decimal(10,2)
  disputed_amount decimal(10,2)
  raised_by uuid
  raised_at timestamp [default: `now()`]
  assigned_to uuid
  resolution text
  resolved_by uuid
  resolved_at timestamp
  resolution_category varchar(100)
  final_hours decimal(5,2)
  final_amount decimal(10,2)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table compliance_items {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  description text
  item_code varchar(50)
  category varchar(50) [default: 'certification']
  has_expiration boolean [default: true]
  validity_period_days int
  renewal_reminder_days int [default: 30]
  grace_period_days int [default: 0]
  requires_verification boolean [default: true]
  verification_authority varchar(255)
  verification_url text
  requires_document boolean [default: true]
  accepted_document_types text
  is_active boolean [default: true]
  is_mandatory boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// compliance_items scope — which occupations/specialties/locations/depts this item applies to
Table compliance_item_scopes {
  id uuid [pk, default: `uuid_generate_v4()`]
  compliance_item_id uuid [not null]
  scope_type varchar(30) [not null, note: 'occupation | specialty | location | department']
  scope_id uuid [not null, note: 'FK to the relevant table determined by scope_type']
  created_at timestamp [default: `now()`]
}

// Compliance checklist templates — created in 2-step modal (name/desc → pick items)
// Linked to requisition_template; show occupation/specialty in list view (via counts)
Table compliance_checklists {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  description text
  occupation_id uuid [note: 'display label in list view e.g. Registered Nurse']
  specialty_id uuid [note: 'display label in list view e.g. ICU']
  is_active boolean [default: true]
  usage_count int [default: 0]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Items selected for a checklist — explicit join so required flag can be set per item
Table compliance_checklist_items {
  id uuid [pk, default: `uuid_generate_v4()`]
  checklist_id uuid [not null]
  compliance_list_item_id uuid [not null]
  is_required boolean [default: true, note: 'drives required count shown in UI']
  created_at timestamp [default: `now()`]
}

Table workforce_lists {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  description text
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table workforce_list_members {
  id uuid [pk, default: `uuid_generate_v4()`]
  list_id uuid [not null]
  candidate_id uuid [not null]
  added_by uuid
  added_at timestamp [default: `now()`]
}

// Org-level global routing delay config (Routing Delay tab)
Table shift_routing_settings {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null, unique, note: 'one config row per org']
  enable_routing_delay boolean [default: false, note: 'Enable Routing Delay toggle']
  delay_duration integer [default: 24, note: 'Delay Duration value']
  delay_unit varchar(20) [default: 'hours', note: 'hours | minutes | days']
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Per-org routing priority for CandidateWorkforceType; labels/descriptions in app (@repo/shared)
Table shift_routing_tiers {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  workforce_type varchar(50) [not null, note: 'SELF | INTERNAL_FULL_TIME | INTERNAL_PART_TIME | INTERNAL_PRN | INTERNAL_FLOAT_POOL | INTERNAL_VOLUNTEER | EXTERNAL_1099 | EXTERNAL_EOR | EXTERNAL_VENDOR_LTO | EXTERNAL_VENDOR_PER_DIEM']
  priority_order integer [not null, note: 'drag-and-drop sort order; 1 = highest priority']
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Only 2 fixed types (Behavioral = Conduct Issue, Clinical = Patient Safety)
// Status is driven automatically by task completion: open → in_progress → resolved
Table grievances {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  grievance_number varchar(50) [not null, note: 'auto-generated e.g. GRV-001']
  type varchar(20) [not null, note: 'behavioral | clinical']
  candidate_id uuid [not null, note: 'linked worker']
  placement_id uuid [note: 'optional — linked active placement']
  description text [not null]
  status varchar(20) [default: 'open', note: 'open | in_progress | resolved — driven by task completion']
  created_by uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Tasks linked to a grievance — completion drives grievance status automatically
Table grievance_tasks {
  id uuid [pk, default: `uuid_generate_v4()`]
  grievance_id uuid [not null]
  category varchar(100) [not null, note: 'investigation_required | documentation_review | employee_interview | corrective_action | performance_improvement_plan | policy_review | training_required | followup_meeting']
  assigned_to_user_id uuid [not null]
  assigned_role varchar(50) [not null]
  description text [not null]
  status varchar(20) [default: 'pending', note: 'pending | in_progress | completed']
  completed_at timestamp
  created_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table invoices {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  invoice_number varchar(50) [not null]
  invoice_type varchar(50)
  vendor_id uuid
  bill_to_name varchar(255)
  bill_to_address text
  invoice_date date [not null]
  due_date date [not null]
  period_start_date date
  period_end_date date
  subtotal decimal(15,2) [default: 0]
  tax_amount decimal(15,2) [default: 0]
  discount_amount decimal(15,2) [default: 0]
  adjustment_amount decimal(15,2) [default: 0]
  total_amount decimal(15,2) [default: 0]
  amount_paid decimal(15,2) [default: 0]
  payment_terms varchar(50) [default: 'net_30']
  payment_method varchar(50)
  payment_reference varchar(255)
  paid_date date
  status varchar(50) [default: 'draft']
  submitted_by uuid
  submitted_at timestamp
  reviewed_by uuid
  reviewed_at timestamp
  review_notes text
  approved_by uuid
  approved_at timestamp
  approval_notes text
  sent_to_client_at timestamp
  invoice_pdf_url text
  backup_documents jsonb
  internal_notes text
  client_notes text
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table invoice_line_items {
  id uuid [pk, default: `uuid_generate_v4()`]
  invoice_id uuid [not null]
  timesheet_id uuid
  placement_id uuid
  candidate_id uuid
  description text [not null]
  quantity decimal(10,2) [default: 1]
  unit_price decimal(10,2) [not null]
  line_item_type varchar(100)
  created_at timestamp [default: `now()`]
}

Table spend_analytics {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  period_start date [not null]
  period_end date [not null]
  period_type varchar(20) [not null]
  department_id uuid
  location_id uuid
  vendor_id uuid
  occupation_id uuid
  project_id uuid
  total_spend decimal(15,2) [default: 0]
  regular_hours decimal(10,2) [default: 0]
  overtime_hours decimal(10,2) [default: 0]
  total_hours decimal(10,2) [default: 0]
  active_placements int [default: 0]
  total_invoices int [default: 0]
  average_bill_rate decimal(10,2) [default: 0]
  permanent_headcount int [default: 0]
  contingent_headcount int [default: 0]
  contractor_headcount int [default: 0]
  calculated_at timestamp [default: `now()`]
}

Table command_center_metrics {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  metric_date date [not null]
  overdue_submissions int [default: 0]
  aging_qualified int [default: 0]
  aging_shortlisted int [default: 0]
  overdue_offers int [default: 0]
  delayed_onboarding int [default: 0]
  active_requisitions int [default: 0]
  open_positions int [default: 0]
  filled_positions_mtd int [default: 0]
  total_submissions int [default: 0]
  submissions_submitted int [default: 0]
  submissions_qualified int [default: 0]
  submissions_shortlisted int [default: 0]
  submissions_interview_scheduled int [default: 0]
  submissions_interview_completed int [default: 0]
  submissions_offer int [default: 0]
  submissions_accepted int [default: 0]
  submissions_withdrawn int [default: 0]
  submissions_rejected int [default: 0]
  total_active_workforce int [default: 0]
  permanent_count int [default: 0]
  contingent_count int [default: 0]
  contractor_count int [default: 0]
  fill_rate decimal(5,2) [default: 0]
  time_to_fill_avg decimal(5,2) [default: 0]
  retention_rate decimal(5,2) [default: 0]
  candidate_satisfaction decimal(3,2) [default: 0]
  client_satisfaction decimal(3,2) [default: 0]
  compliance_rate decimal(5,2) [default: 0]
  expiring_credentials int [default: 0]
  pending_timesheets int [default: 0]
  disputed_timesheets int [default: 0]
  spend_mtd decimal(15,2) [default: 0]
  hours_worked_mtd decimal(10,2) [default: 0]
  calculated_at timestamp [default: `now()`]
}

Table billing_configs {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  vendor_id uuid
  client_name varchar(255)
  billing_frequency varchar(50) [default: 'weekly']
  payment_terms varchar(50) [default: 'net_30']
  invoice_format varchar(50)
  rate_card jsonb
  markup_type varchar(50)
  markup_value decimal(10,2)
  invoice_delivery_method varchar(50)
  invoice_email_recipients text
  requires_po boolean [default: false]
  po_number varchar(100)
  po_expiry_date date
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table notifications_org {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  user_id uuid [not null]
  type varchar(100) [not null]
  title varchar(255) [not null]
  message text
  entity_type varchar(50)
  entity_id uuid
  action_url text
  delivery_method varchar(50)
  sent_at timestamp
  is_read boolean [default: false]
  read_at timestamp
  priority varchar(20) [default: 'normal']
  created_at timestamp [default: `now()`]
}

Table activity_log_org {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  user_id uuid
  user_email varchar(255)
  user_name varchar(255)
  action varchar(100) [not null]
  entity_type varchar(50) [not null]
  entity_id uuid [not null]
  entity_name varchar(255)
  description text
  changes jsonb
  ip_address varchar(50)
  user_agent text
  session_id varchar(255)
  created_at timestamp [default: `now()`]
}

// Refs for new org-portal tables

// shift_templates
Ref: shift_templates.organization_id > organization.id
Ref: shift_templates.occupation_id > occupation.id
Ref: shift_templates.department_id > department.id
Ref: shift_templates.location_id > organization_location.id
Ref: shift_templates.created_by > user.id
Ref: shift_templates.updated_by > user.id

// per_diem_shifts
Ref: per_diem_shifts.organization_id > organization.id
Ref: per_diem_shifts.shift_template_id > shift_templates.id
Ref: per_diem_shifts.location_id > organization_location.id
Ref: per_diem_shifts.department_id > department.id
Ref: per_diem_shifts.occupation_id > occupation.id
Ref: per_diem_shifts.specialty_id > specialty.id
Ref: per_diem_shifts.routing_rule_id > shift_routing_settings.id
Ref: per_diem_shifts.created_by > user.id
Ref: per_diem_shifts.updated_by > user.id

// shift_routing_settings & tiers
Ref: shift_routing_settings.organization_id > organization.id
Ref: shift_routing_settings.created_by > user.id
Ref: shift_routing_settings.updated_by > user.id
Ref: shift_routing_tiers.organization_id > organization.id

Ref: per_diem_assignments.shift_id > per_diem_shifts.id
Ref: per_diem_assignments.candidate_id > candidate.id
Ref: per_diem_assignments.assigned_by > user.id
Ref: per_diem_assignments.approved_by > user.id
Ref: per_diem_assignments.cancelled_by > user.id

Ref: timesheet_disputes.timesheet_id > timesheet.id
Ref: timesheet_disputes.raised_by > user.id
Ref: timesheet_disputes.assigned_to > user.id
Ref: timesheet_disputes.resolved_by > user.id

Ref: compliance_items.organization_id > organization.id
Ref: compliance_items.created_by > user.id
Ref: compliance_items.updated_by > user.id


Ref: workforce_lists.organization_id > organization.id
Ref: workforce_lists.created_by > user.id
Ref: workforce_lists.updated_by > user.id
Ref: workforce_list_members.list_id > workforce_lists.id
Ref: workforce_list_members.candidate_id > candidate.id
Ref: workforce_list_members.added_by > user.id


Ref: grievances.organization_id > organization.id
Ref: grievances.candidate_id > candidate.id
Ref: grievances.placement_id > placement.id
Ref: grievances.created_by > user.id
Ref: grievance_tasks.grievance_id > grievances.id
Ref: grievance_tasks.assigned_to_user_id > user.id
Ref: grievance_tasks.created_by > user.id

Ref: invoices.organization_id > organization.id
Ref: invoices.vendor_id > vendor.id
Ref: invoices.submitted_by > user.id
Ref: invoices.reviewed_by > user.id
Ref: invoices.approved_by > user.id
Ref: invoice_line_items.invoice_id > invoices.id
Ref: invoice_line_items.timesheet_id > timesheet.id
Ref: invoice_line_items.placement_id > placement.id
Ref: invoice_line_items.candidate_id > candidate.id

Ref: spend_analytics.organization_id > organization.id
Ref: spend_analytics.department_id > department.id
Ref: spend_analytics.location_id > organization_location.id
Ref: spend_analytics.vendor_id > vendor.id
Ref: spend_analytics.occupation_id > occupation.id
Ref: spend_analytics.project_id > project.id

Ref: command_center_metrics.organization_id > organization.id

Ref: billing_configs.organization_id > organization.id
Ref: billing_configs.vendor_id > vendor.id

Ref: notifications_org.organization_id > organization.id
Ref: notifications_org.user_id > user.id

Ref: activity_log_org.organization_id > organization.id
Ref: activity_log_org.user_id > user.id
