// =============================================================================
// Workforce Management - dbdiagram.io Schema (DBML)
// =============================================================================
// Based on: packages/db/prisma/schema.prisma + vendor.sql, candidate.sql, adin.sql, Org.sql
// Best practices: UUID PKs, indexed FKs, explicit refs, extensible for jobs/submissions/placements
// =============================================================================

Project workforce_schema {
  database_type: 'PostgreSQL'
  Note: 'Workforce management: orgs, vendors, MSP, compliance, questionnaires. Extensible to requisitions, submissions, placements.'
}

// =============================================================================
// ENUMS (DBML doesn't support enums; use note on columns)
// =============================================================================

// =============================================================================
// CORE: Auth & Users
// =============================================================================

Table user {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  email_verified boolean [default: false]
  image varchar(500)
  role varchar(50) [not null, note: 'UserRole: SUPER_ADMIN, GENERAL_ADMIN, CANDIDATE_USER, etc.']
  status varchar(20) [default: 'ACTIVE', note: 'UserStatus']
  title varchar(255)
  phone_number varchar(50)
  office_phone varchar(50)
  time_zone varchar(100)
  msp_id uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  
  Note: 'Platform users: program, vendor, org, candidate'
}

Table session {
  id uuid [pk, default: `uuid_generate_v4()`]
  expires_at timestamp [not null]
  token varchar(500) [not null, unique]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  ip_address varchar(45)
  user_agent text
  user_id uuid [not null]
  active_organization_id uuid
}

Table account {
  id uuid [pk, default: `uuid_generate_v4()`]
  account_id varchar(255) [not null]
  provider_id varchar(255) [not null]
  user_id uuid [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope varchar(255)
  password varchar(255)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table verification {
  id uuid [pk, default: `uuid_generate_v4()`]
  identifier varchar(255) [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// CORE: Organizations & Structure
// =============================================================================

Table organization {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  email varchar(255) [not null]
  phone varchar(50) [not null]
  industry varchar(50) [not null, note: 'OrganizationIndustry']
  organization_type varchar(50) [not null, note: 'OrganizationType']
  timezone varchar(50) [not null, note: 'OrganizationTimezone']
  website varchar(500)
  logo varchar(500)
  metadata text
  service_agreement text
  description text
  agreement_renewal_date timestamp
  is_active boolean [default: true]
  expected_annual_spend decimal(15,2)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table organization_location {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  address varchar(500) [not null]
  city varchar(100) [not null]
  state varchar(50) [not null]
  zip_code varchar(20) [not null]
  location_type varchar(50) [not null, note: 'HEADQUARTERS, BRANCH, SATELLITE, REMOTE']
  phone varchar(50)
  email varchar(255)
  cost_center varchar(100)
  photo_url varchar(500)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table department {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  location_id uuid [not null]
  name varchar(255) [not null]
  department_type varchar(50) [not null, note: 'CLINICAL, NON_CLINICAL, ADMINISTRATIVE']
  cost_center varchar(100)
  organization_occupation_id uuid
  organization_specialty_id uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table member {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  user_id uuid [not null]
  role varchar(50) [not null, note: 'MemberRole']
  status varchar(20) [default: 'ACTIVE']
  last_invite_status varchar(20) [default: 'NOT_SENT']
  last_invite_at timestamp
  last_invite_scheduled_for timestamp
  last_invite_job_id uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table department_user {
  id uuid [pk, default: `uuid_generate_v4()`]
  department_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table department_timekeeping_approver {
  id uuid [pk, default: `uuid_generate_v4()`]
  department_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// VENDORS & MSP
// =============================================================================

Table address {
  id uuid [pk, default: `uuid_generate_v4()`]
  street varchar(255) [not null]
  city varchar(100) [not null]
  state varchar(50) [not null]
  zip_code varchar(20) [not null]
  country varchar(100) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table vendor {
  id uuid [pk, default: `uuid_generate_v4()`]
  logo varchar(500)
  name varchar(255) [not null]
  industries varchar(50) [note: 'OrganizationIndustry[]']
  certified_business_classifications varchar(50) [note: 'CertifiedBusinessClassification[]']
  about text
  is_active boolean [default: true]
  tax_id varchar(50)
  phone_number varchar(50)
  website varchar(500)
  address_id uuid
  annual_revenue decimal(15,2)
  employee_count integer
  internal_id varchar(100) [not null, unique]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table organization_vendor {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  vendor_id uuid [not null]
  status varchar(20) [default: 'PENDING', note: 'PENDING, ACTIVE']
  start_date timestamp
  contract_document_key varchar(255)
  contract_file_name varchar(255)
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table vendor_user {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [not null, unique]
  vendor_id uuid [not null]
  role varchar(50) [not null, note: 'VENDOR_MANAGER, VENDOR_USER, VENDOR_VIEW_ONLY']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table msp {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  logo varchar(500)
  industry varchar(50) [not null]
  organization_type varchar(50) [not null, note: 'MSPOrganizationType']
  headquarters_id uuid [not null]
  billing_id uuid
  is_billing_same boolean [default: true]
  phone_number varchar(50) [not null]
  timezone varchar(50) [not null]
  msa_document varchar(500) [not null]
  msa_file_name varchar(255)
  msa_uploaded_at timestamp
  msa_agreement_revision_date timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table msp_linked_orgs {
  id uuid [pk, default: `uuid_generate_v4()`]
  msp_id uuid [not null]
  organization_id uuid [not null]
  addendum_agreement varchar(500) [not null]
  start_date timestamp [not null]
  renewal_date timestamp [not null]
  possible_cancellation_date timestamp
  msp_fee_percentage decimal(5,2) [not null]
  saas_fee_percentage decimal(5,2) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// OCCUPATIONS & SPECIALTIES
// =============================================================================

Table occupation {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  code varchar(50) [not null]
  industry varchar(50)
  acronym varchar(50) [not null]
  description text
  status varchar(20) [default: 'ACTIVE']
  has_specialty boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table specialty {
  id uuid [pk, default: `uuid_generate_v4()`]
  acronym varchar(50) [not null]
  name varchar(255) [not null]
  group varchar(100)
  description text
  status varchar(20) [default: 'ACTIVE']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Occupation-Specialty many-to-many (implicit in Prisma via relation table)
Table occupation_specialties {
  id uuid [pk, default: `uuid_generate_v4()`]
  occupation_id uuid [not null]
  specialty_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table organization_occupation {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  occupation_id uuid [not null]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table organization_specialty {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  specialty_id uuid [not null]
  organization_occupation_id uuid [not null]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table vendor_occupation_specialization {
  id uuid [pk, default: `uuid_generate_v4()`]
  vendor_id uuid [not null]
  occupation_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// COMPLIANCE
// =============================================================================

Table compliance_list_item {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  category varchar(50) [not null]
  expiration_type varchar(50) [not null]
  expiration_rule_value integer
  expiration_rule_unit varchar(20)
  issuer_requirement boolean [default: false]
  issuer varchar(255)
  response_style varchar(50) [not null]
  file varchar(500)
  instructional_notes text
  display_to_candidate boolean [not null]
  status varchar(20) [default: 'ACTIVE']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table compliance_wallet_template {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  organization_occupation_id uuid [not null]
  organization_specialty_id uuid
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table compliance_wallet_template_item {
  id uuid [pk, default: `uuid_generate_v4()`]
  compliance_wallet_template_id uuid [not null]
  compliance_list_item_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// QUESTIONNAIRES & TAGGING
// =============================================================================

// =============================================================================

Table tag {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  type varchar(50) [not null, note: 'TagType: SKILL | COMPLIANCE | AVAILABILITY | PRIORITY | FLAG']
  description text
  show_on_submission boolean [not null]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | INACTIVE']
  created_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table questionnaire {
  id uuid [pk, default: `uuid_generate_v4()`]
  active boolean [default: true]
  organization_id uuid [not null]
  occupation_id uuid [unique]
  specialty_id uuid [unique]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table question {
  id uuid [pk, default: `uuid_generate_v4()`]
  order integer
  question_text text [not null]
  type varchar(50) [default: 'TEXT']
  options text [note: 'String[]']
  required boolean [default: false]
  include_in_submission boolean [default: true]
  questionnaire_id uuid [not null]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table tagging_rule {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  rule_name varchar(255) [not null]
  category varchar(100) [not null]
  active boolean [default: true]
  show_on_submission boolean [default: true]
  tag_id uuid [not null]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table tagging_rule_question {
  id uuid [pk, default: `uuid_generate_v4()`]
  tagging_rule_id uuid [not null]
  question_id uuid [not null]
  condition varchar(50) [not null, note: 'ConditionType']
  trigger_value varchar(255) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table matching_criterion {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null, unique]
  description text
}

Table matching_logic {
  id uuid [pk, default: `uuid_generate_v4()`]
  active boolean [default: true]
  weight integer [default: 0]
  matching_criterion_id uuid [not null]
  organization_id uuid [not null]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// DOCUMENTS & NOTES
// =============================================================================

Table document {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  type varchar(50) [not null, note: 'DocumentType']
  description text
  url varchar(500) [not null]
  uploaded_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  uploaded_by uuid
  msp_id uuid
  vendor_id uuid
  organization_id uuid
}

Table note {
  id uuid [pk, default: `uuid_generate_v4()`]
  type varchar(50) [not null, note: 'NoteType']
  notes text [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  created_by uuid
  msp_id uuid
  vendor_id uuid
  organization_id uuid
}

// =============================================================================
// EXTENSIBLE: Requisitions / Jobs (from Org.sql, vendor.sql, adin.sql)
// =============================================================================

// 5-step wizard: Template Details → Shift & Schedule → Compensation → Compliance Checklist → Submission Rules
Table requisition_template {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]

  // ── Step 1: Template Details ───────────────────────────────────────────────
  type varchar(50) [not null, note: 'long_term_order | per_diem | permanent_role | internal_flex_pool']
  template_name varchar(255) [not null]
  occupation_id uuid [not null]
  specialty_id uuid [not null]
  location_id uuid [not null]
  department_id uuid [not null]
  unit_name varchar(255) [note: 'e.g. ICU - Night Unit']
  job_description text [not null]
  benefits_perks text [note: 'TEXT[] — free-type tags']
  status varchar(20) [default: 'draft', note: 'draft | active | inactive']

  // ── Step 2: Shift & Schedule ───────────────────────────────────────────────
  start_date date
  end_date date
  length_weeks integer
  start_time time
  end_time time
  shift_type varchar(50) [note: 'standard | per_diem | overtime | on_call | holiday | weekend']
  shift_hours decimal(5,2)
  shifts_per_week integer
  hours_per_week decimal(5,2)

  // ── Step 3: Compensation & Hiring ─────────────────────────────────────────
  bill_rate decimal(10,2) [note: 'per hour']
  number_of_positions integer [default: 1]
  incentive_type varchar(255)
  incentive_amount decimal(10,2)
  interview_required varchar(50) [note: 'required_client | required_program | not_required']
  hiring_manager_id uuid

  // ── Step 4: Compliance Checklist ──────────────────────────────────────────
  compliance_checklist_id uuid [note: 'FK to compliance_checklists']

  // ── Step 5: Submission Rules & Approval ───────────────────────────────────
  requires_approval boolean [default: false, note: 'false = auto-publish; true = needs approval']
  workflow_type varchar(50) [note: 'vendor_candidate_submission | direct_submission | etc.']
  who_can_submit varchar(30) [default: 'all_vendors', note: 'all_vendors | selected_vendors']
  internal_notes text

  // ── Metadata ──────────────────────────────────────────────────────────────
  usage_count integer [default: 0]
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Selected vendors allowed to submit (only populated when who_can_submit = 'selected_vendors')
Table requisition_template_vendor {
  id uuid [pk, default: `uuid_generate_v4()`]
  template_id uuid [not null]
  vendor_id uuid [not null]
  created_at timestamp [default: `now()`]
}

// 6-step wizard: Requisition Type → Select Template → Job Details → Submission Settings → Publish Settings → Review & Confirm
Table requisition {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  requisition_number varchar(50) [not null]

  // ── Step 1: Requisition Type ───────────────────────────────────────────────
  type varchar(50) [not null, note: 'long_term_order | per_diem | permanent_role | internal_flex_pool']

  // ── Step 2: Select Template ────────────────────────────────────────────────
  template_id uuid [not null]

  // ── Step 3: Job Details ────────────────────────────────────────────────────
  job_title varchar(255) [not null]
  occupation_id uuid
  specialty_id uuid
  department_id uuid
  location_id uuid
  unit_name varchar(255)
  hiring_manager_id uuid
  number_of_positions integer [default: 1]
  positions_filled integer [default: 0]
  job_summary text
  bill_rate decimal(10,2)
  shift_type varchar(50)
  start_date date
  end_date date
  length_weeks integer
  shift_hours decimal(5,2)
  shifts_per_week integer
  hours_per_week decimal(5,2)
  benefits_perks text [note: 'TEXT[]']

  // ── Step 4: Submission Settings ────────────────────────────────────────────
  compliance_checklist_id uuid [note: 'overrides template default if set']
  requires_approval boolean [default: false]
  workflow_type varchar(50) [note: 'vendor_candidate_submission | direct_submission']
  who_can_submit varchar(30) [default: 'all_vendors', note: 'all_vendors | selected_vendors']
  internal_notes text

  // ── Step 5: Publish Settings ───────────────────────────────────────────────
  publish_mode varchar(30) [default: 'draft', note: 'draft | publish_immediately | scheduled']
  scheduled_publish_at timestamp [note: 'set when publish_mode = scheduled']
  published_at timestamp [note: 'actual timestamp when requisition went live']

  // ── Lifecycle & Approval ───────────────────────────────────────────────────
  status varchar(50) [default: 'draft', note: 'draft | pending_approval | approved | published | active | on_hold | filled | cancelled | closed']
  approved_by uuid
  approved_at timestamp
  total_submissions integer [default: 0]
  qualified_candidates integer [default: 0]
  project_id uuid
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Selected vendors for a specific requisition (when who_can_submit = 'selected_vendors')
Table requisition_vendor {
  id uuid [pk, default: `uuid_generate_v4()`]
  requisition_id uuid [not null]
  vendor_id uuid [not null]
  created_at timestamp [default: `now()`]
}

// =============================================================================
// EXTENSIBLE: Candidates (talent community)
// =============================================================================

Table candidate {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  user_id uuid
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null]
  phone varchar(50)
  occupation_id uuid
  street_address varchar(255)
  years_of_experience integer
  workforce_type varchar(50) [note: 'internal_full_time | internal_part_time | internal_prn | external_vendor_lto | external_vendor_per_diem']
  workforce_group varchar(255) [note: 'e.g. Nursing Staff, Rehabilitation Team']
  vendor_id uuid [note: 'FK to vendor — populated for external/vendor candidates; null for internal']
  source varchar(100) [note: 'direct | vendor | previous_worker — shown in Add Existing Talent modal']
  city varchar(100)
  state varchar(50)
  zip_code varchar(20)
  willing_to_relocate boolean [default: false]
  resume_url varchar(500)
  portfolio_url varchar(500)
  linkedin_url varchar(500)
  bio text
  avatar_url varchar(500)
  skills text [note: 'freeform skill labels stored as PostgreSQL text[]; no FK target']
  languages text [note: 'freeform language labels stored as PostgreSQL text[]']
  preferred_shift_types text [note: 'shift type preferences e.g. day,night stored as text[]']
  desired_bill_rate decimal(10,2)
  is_active boolean [default: true]
  is_available boolean [default: true]
  available_from date
  source_details text

  // ── Invite flow (Invited Candidates tab) ──────────────────────────────────
  invite_status varchar(20) [note: 'pending | accepted | expired — null for non-invited candidates']
  invited_at timestamp
  invited_by uuid [note: 'FK to user who sent the invite']
  invite_token varchar(255) [note: 'secure token for the invite email link']
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Candidate → Specialty many-to-many
Table candidate_specialties {
  id uuid [pk, default: `uuid_generate_v4()`]
  candidate_id uuid [not null]
  specialty_id uuid [not null]
  created_at timestamp [default: `now()`]
}

// Candidate → Tag many-to-many (replaces tags text[] on candidate)
Table candidate_tags {
  id uuid [pk, default: `uuid_generate_v4()`]
  candidate_id uuid [not null]
  tag_id uuid [not null]
  created_at timestamp [default: `now()`]
}

// Candidate preferred locations — replaces preferred_locations UUID[] on candidate
Table candidate_preferred_locations {
  id uuid [pk, default: `uuid_generate_v4()`]
  candidate_id uuid [not null]
  location_id uuid [not null]
  created_at timestamp [default: `now()`]
}

// =============================================================================
// EXTENSIBLE: Submissions & Placements
// =============================================================================

Table submission {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  requisition_id uuid [not null]
  candidate_id uuid [not null]
  vendor_id uuid
  submitted_by_user_id uuid
  bill_rate decimal(10,2) [not null]
  overtime_rate decimal(10,2)
  stage varchar(50) [default: 'submitted', note: 'submitted, qualified, shortlisted, interview_scheduled, interview_completed, offer, accepted, withdrawn, rejected']
  stage_entered_at timestamp [default: `now()`]
  submitted_at timestamp [default: `now()`]
  qualified_at timestamp
  shortlisted_at timestamp
  interview_scheduled_at timestamp
  interview_completed_at timestamp
  offer_extended_at timestamp
  accepted_at timestamp
  withdrawn_at timestamp
  rejected_at timestamp
  interview_date timestamp
  interview_location varchar(255)
  interview_notes text
  offer_amount decimal(10,2)
  offer_letter_url varchar(500)
  offer_expires_at timestamp
  offered_without_interview boolean [default: false]
  rejection_reason text
  withdrawal_reason text
  internal_notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Interviewers for a submission — replaces interviewer_ids UUID[] on submission
Table submission_interviewers {
  id uuid [pk, default: `uuid_generate_v4()`]
  submission_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]
}

// Auto-created when a candidate accepts a job offer
Table placement {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  placement_number varchar(50) [not null, note: 'auto-generated display ID e.g. PLC-2025-001']

  // ── Relations ─────────────────────────────────────────────────────────────
  // requisition / candidate / vendor are NOT stored here — derive from submission
  submission_id uuid [not null]
  vendor_contact_id uuid [note: 'FK to user — Vendor Contact shown in Vendor & Contacts section']
  hiring_manager_id uuid
  department_id uuid
  location_id uuid

  // ── Denormalized display fields ────────────────────────────────────────────
  job_title varchar(255) [note: 'snapshot from requisition at acceptance time']
  unit_name varchar(255) [note: 'e.g. ICU - Unit 3A; shown in Department/Unit column']
  workforce_group varchar(255) [note: 'e.g. Nursing Staff']

  // ── Assignment Period ─────────────────────────────────────────────────────
  start_date date [not null]
  end_date date
  actual_end_date date
  total_weeks integer [note: 'derived from start/end; used for Week X of Y status label']
  extension_count integer [default: 0]

  // ── Schedule & Shift ─────────────────────────────────────────────────────
  shift_type varchar(50) [note: 'night | day | evening | on_call']
  shift_start_time time [note: 'e.g. 7:00 PM']
  shift_end_time time [note: 'e.g. 7:00 AM']
  shift_schedule text [note: 'TEXT[] — e.g. Monday, Tuesday, Friday, Saturday']
  hours_per_week decimal(5,2)

  // ── Rates & Compensation ──────────────────────────────────────────────────
  bill_rate decimal(10,2) [not null, note: 'rate charged to client; snapshot at acceptance']
  pay_rate decimal(10,2) [not null, note: 'rate paid to candidate; snapshot at acceptance']
  overtime_eligible boolean [default: false]

  // ── Offer Acceptance Summary ──────────────────────────────────────────────
  employment_type varchar(50) [note: 'contract | permanent | per_diem']
  accepted_by uuid [note: 'FK to user who accepted the offer (candidate user)']
  accepted_at timestamp [note: 'Acceptance Date in Offer History tab']

  // ── Status & Lifecycle ────────────────────────────────────────────────────
  status varchar(50) [default: 'upcoming', note: 'upcoming | active | completed | terminated | on_hold']
  termination_reason text
  terminated_by uuid
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Compliance tab: per-item compliance status for this placement
// Compares requisition checklist items against candidate's compliance wallet
Table placement_compliance_items {
  id uuid [pk, default: `uuid_generate_v4()`]
  placement_id uuid [not null]
  compliance_list_item_id uuid [not null, note: 'the requirement from the requisition checklist']
  status varchar(20) [not null, default: 'missing', note: 'complete | missing | expired']
  completion_date date [note: 'set when status = complete']
  expiry_date date [note: 'set for expirable documents like licenses']
  is_required boolean [default: true]
  swapped_from_item_id uuid [note: 'self-ref: tracks Swap Item action']
  removed_at timestamp [note: 'soft-delete via Remove Item action']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Offer History tab: immutable event log of every offer state change
Table placement_offer_history {
  id uuid [pk, default: `uuid_generate_v4()`]
  placement_id uuid [not null]
  event_type varchar(50) [not null, note: 'offer_extended | offer_viewed | offer_accepted | offer_declined | offer_expired | offer_modified']
  description text [note: 'e.g. Initial offer sent to candidate via email']
  bill_rate_snapshot decimal(10,2)
  pay_rate_snapshot decimal(10,2)
  start_date_snapshot date
  employment_type varchar(50)
  performed_by uuid [note: 'FK to user who triggered the event']
  performed_at timestamp [not null, default: `now()`]
}

// Notes & Tasks tab: tasks specific to this placement
Table placement_tasks {
  id uuid [pk, default: `uuid_generate_v4()`]
  placement_id uuid [not null]
  title varchar(255) [not null]
  description text
  due_date date
  status varchar(20) [default: 'pending', note: 'pending | completed']
  assigned_to uuid [note: 'FK to user; shows "Assigned to: Emily Rodriguez"']
  assigned_role varchar(100) [note: 'role label e.g. Compliance Team']
  completed_at timestamp
  created_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Notes & Tasks tab: freeform notes on this placement
Table placement_notes {
  id uuid [pk, default: `uuid_generate_v4()`]
  placement_id uuid [not null]
  content text [not null]
  created_by uuid [note: 'FK to user; null = system-generated note']
  created_by_role varchar(100) [note: 'role snapshot at time of note creation — intentional denormalization for audit display']
  created_at timestamp [default: `now()`]
}

// =============================================================================
// EXTENSIBLE: Timekeeping
// =============================================================================

Table timesheet {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  placement_id uuid [not null]
  candidate_id uuid [not null, note: 'intentional denormalization — avoids join on every timesheet query']
  week_ending_date date [not null]
  regular_hours decimal(5,2) [default: 0]
  overtime_hours decimal(5,2) [default: 0]
  total_hours decimal(5,2) [default: 0]
  regular_amount decimal(10,2)
  overtime_amount decimal(10,2)
  total_amount decimal(10,2)
  status varchar(50) [default: 'draft', note: 'draft, submitted, approved, rejected, paid']
  submitted_at timestamp
  approved_by uuid
  approved_at timestamp
  rejected_by uuid
  rejected_at timestamp
  rejection_reason text
  paid_at timestamp
  payment_reference varchar(255)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table timesheet_entry {
  id uuid [pk, default: `uuid_generate_v4()`]
  timesheet_id uuid [not null]
  work_date date [not null]
  clock_in time
  clock_out time
  break_minutes integer [default: 0]
  regular_hours decimal(5,2) [default: 0]
  overtime_hours decimal(5,2) [default: 0]
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// EXTENSIBLE: Compliance per candidate
// =============================================================================

// Candidate's Document Wallet — documents self-uploaded by the candidate
Table candidate_compliance {
  id uuid [pk, default: `uuid_generate_v4()`]
  candidate_id uuid [not null]
  document_name varchar(255) [not null, note: 'e.g. Driver\'s License, Passport']
  category varchar(50) [not null, note: 'background_identity | employee_health | professional_licenses | certifications | other']
  document_url text [note: 'PDF/JPG/PNG max 10MB']
  document_file_name varchar(255)
  expiry_date date [note: 'optional; drives expired status']
  status varchar(30) [default: 'pending', note: 'approved | pending | expired | missing']
  verified_by uuid
  verified_at timestamp
  notes text
  uploaded_by uuid
  uploaded_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// JOBS & ACTIVITY
// =============================================================================

Table background_job {
  id uuid [pk, default: `uuid_generate_v4()`]
  type varchar(50) [not null]
  status varchar(20) [default: 'PENDING']
  payload jsonb [not null]
  result jsonb
  organization_id uuid
  scheduled_for timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  completed_at timestamp
}

// A project is simply a named group of requisitions for organization and tracking
Table project {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  name varchar(255) [not null]
  description text
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_by uuid
  updated_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Global metric definitions (platform-level, reusable across all orgs)
Table metric {
  id uuid [pk, default: `uuid_generate_v4()`]
  type varchar(50) [not null, note: 'RECRUITMENT_EFFICIENCY | COMPLIANCE | QUALITY_OF_SERVICE']
  name varchar(255) [not null, unique]
  formula text [not null]
  status boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// Per-org assignment of a global metric with an org-specific goal value
Table organization_metric {
  id uuid [pk, default: `uuid_generate_v4()`]
  organization_id uuid [not null]
  metric_id uuid [not null]
  goal decimal(10,2) [not null, note: 'org-specific target value for this metric']
  is_active boolean [default: true]
  created_by uuid
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

