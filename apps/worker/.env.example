NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/workforce

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# SMTP / Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=StaffLogic

# AWS S3
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Sign-in URL embedded in invitation emails (admin portal)
ADMIN_FRONTEND_URL=http://localhost:3000
# Base URL of the org portal — slug is prepended as subdomain per invite
# Dev: http://localhost:3002 → test-org.localhost:3002/sign-in
# Prod: https://stafflogic.com → test-org.stafflogic.com/sign-in
ORG_PORTAL_BASE_URL=http://localhost:3002
