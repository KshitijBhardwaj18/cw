# Public — exposed to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Org subdomain config
# local: http   production: https
NEXT_PUBLIC_ORG_PORTAL_PROTOCOL=http
# local: localhost:3002   production: stafflogic.com
NEXT_PUBLIC_ORG_PORTAL_DOMAIN=stafflogic.com

# Server-only — proxy target for /api/* (falls back to NEXT_PUBLIC_API_URL if unset)
BACKEND_API_URL=http://localhost:3001

# OAuth (used server-side for sign-in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=3000
