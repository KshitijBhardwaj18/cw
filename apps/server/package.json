		"@repo/typescript-config": "*",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/multer": "^2.0.0",
		"@types/node": "^22.10.7",
		"@types/pdfkit": "^0.17.3",
		"@types/supertest": "^6.0.2",
