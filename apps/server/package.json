		"@nestjs/swagger": "^11.2.6",
		"@opentelemetry/api": "^1.9.0",
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@repo/casl": "*",
		"@repo/db": "*",
		"@repo/mail": "*",
		"@repo/shared": "*",
