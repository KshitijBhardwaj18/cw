{
  "name": "workforce",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.6",
  "scripts": {
    "billing:reseed-schedules": "bun run --cwd apps/server billing:reseed-schedules",
    "build": "turbo run build",
    "db:deploy": "turbo run db:deploy",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:reset": "turbo run db:reset",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:seed:all": "bun run --cwd packages/db db:seed:all",
    "db:seed:demo": "bun run --cwd packages/db db:seed:demo",
    "db:seed:tui": "bun run --cwd packages/db db:seed:tui",
    "dev": "turbo run dev",
    "find-deadcode": "turbo run find-deadcode",
    "find-deadcode:server": "bun find-deadcode --cwd apps/server",
    "find-deadcode:web": "bun find-deadcode --cwd apps/web",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "package": "turbo run package",
    "prepare": "husky",
    "start": "turbo run start",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@casl/prisma": "^1.6.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heizen-labs/logger": "^1.0.0",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-pacer": "^0.20.0",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-devtools": "^5.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/pdfkit": "^0.17.5",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.18.0",
    "react": "^19.2.5",
    "react-day-picker": "9.7.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "sst": "4.12.11",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@repo/typescript-config": "*",
    "@types/aws-lambda": "8.10.161",
    "husky": "^9.1.7",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/server",
    "packages/*",
    "apps/worker",
    "apps/admin-web",
    "apps/org-web"
  ]
}
